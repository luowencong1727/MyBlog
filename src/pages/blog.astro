---
import "../styles/global.css";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Blog | Luo Wencong</title>
        <meta
            name="description"
            content="Luo Wencong 的博客，记录编程、AI、雅思和个人思考。"
        />
    </head>

    <body>
        <header>
            <nav>
                <a href="/">Home</a>
                <a href="/blog">Blog</a>
                <a href="/projects">Projects</a>
                <a href="/about">About</a>
            </nav>
        </header>

        <main>
            <section id="home-section">
                <h1>Blog</h1>
            </section>
                
            <section class="content-section">
                {
                    posts.map((post) => (
                        <article>
                            <h3>
                                <a href={`/blog/${post.id}`}>
                                    {post.data.title}
                                </a>
                            </h3>
                            
                            <p>{post.data.description}</p>

                            <p>{post.data.date.toLocaleDateString()}</p>
                        </article>
                    ))
                }
            </section>
        </main>
        
        <footer id="footer">
            <p><em>© 2026 Luo Wencong</em></p>
            <p><em>Email:luowencong12@gmail.com</em></p>
            <a href="https://github.com/luowencong1727"><em>Github</em></a>
        </footer>
    </body>
</html>