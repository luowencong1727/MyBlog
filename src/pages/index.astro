---
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latestPosts = allPosts.slice(0, 3);
const emptySlots = Math.max(0, 3 - latestPosts.length);

const latestCards = [
    ...latestPosts.map((post, index) => ({
        kind: "post" as const,
        number: String(index + 1).padStart(2, "0"),
        title: post.data.title,
        description: post.data.description,
        category: post.data.category,
        href: `/blog/${post.id}`,
        dateLabel: post.data.date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            timeZone: "Asia/Shanghai",
        }),
        dateTime: post.data.date.toISOString().slice(0, 10),
    })),
    ...Array.from({ length: emptySlots }, (_, index) => ({
        kind: "empty" as const,
        number: String(latestPosts.length + index + 1).padStart(2, "0"),
    })),
];
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>Luo Wencong — Engineering Notes</title>
        <meta
            name="description"
            content="罗文聪的个人技术博客，记录代码、系统、AI 与持续学习。"
        />
    </head>

    <body>
        <div class="home-shell">
            <header class="site-header">
                <a class="brand" href="/" aria-label="罗文聪个人网站首页">
                    <span class="brand-monogram" aria-hidden="true">LW<span>.</span></span>
                    <span class="brand-text">
                        <strong>Luo Wencong</strong>
                        <span>Engineering notes</span>
                    </span>
                </a>

                <div class="header-bar">
                    <nav class="top-nav" aria-label="主导航">
                        <a class="is-active" href="/" aria-current="page">
                            <span>01</span>Home
                        </a>
                        <a href="/blog"><span>02</span>Blog</a>
                        <a href="/projects"><span>03</span>Projects</a>
                        <a href="/about"><span>04</span>About</a>
                    </nav>
                    <div class="build-state" aria-label="网站索引状态">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span>INDEX / 2026</span>
                    </div>
                </div>
            </header>

            <div class="page-frame">
                <aside class="content-directory" aria-label="网站内容目录">
                    <div class="directory-heading">
                        <span>DOCUMENT MAP</span>
                        <span>v.2026</span>
                    </div>

                    <nav class="directory-tree" aria-label="内容索引">
                        <details class="directory-group" open>
                            <summary>
                                <span class="directory-number">01</span>
                                <span class="directory-label">所有博客</span>
                                <span class="directory-count"
                                    >{String(allPosts.length).padStart(2, "0")}</span
                                >
                                <svg
                                    class="directory-chevron"
                                    viewBox="0 0 16 16"
                                    aria-hidden="true"
                                >
                                    <path d="m3 6 5 5 5-5" />
                                </svg>
                            </summary>

                            <div class="directory-panel">
                                <a class="directory-overview" href="/blog">
                                    <span>00</span>
                                    <span>文章归档</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                                {
                                    allPosts.map((post, index) => (
                                        <a
                                            class="directory-entry"
                                            href={`/blog/${post.id}`}
                                        >
                                            <span>{String(index + 1).padStart(2, "0")}</span>
                                            <span>{post.data.title}</span>
                                        </a>
                                    ))
                                }
                            </div>
                        </details>

                        <details class="directory-group">
                            <summary>
                                <span class="directory-number">02</span>
                                <span class="directory-label">所有项目</span>
                                <span class="directory-count">00</span>
                                <svg
                                    class="directory-chevron"
                                    viewBox="0 0 16 16"
                                    aria-hidden="true"
                                >
                                    <path d="m3 6 5 5 5-5" />
                                </svg>
                            </summary>

                            <div class="directory-panel">
                                <a class="directory-overview" href="/projects">
                                    <span>00</span>
                                    <span>项目归档</span>
                                    <span aria-hidden="true">↗</span>
                                </a>
                                <p class="directory-empty">
                                    暂无项目条目
                                    <span>PROJECTS WILL APPEAR HERE</span>
                                </p>
                            </div>
                        </details>
                    </nav>

                    <div class="directory-note">
                        <span>READING MODE</span>
                        <p>点击分类展开目录。</p>
                    </div>
                </aside>

                <main class="home-main">
                    <div class="content-column">
                        <section class="hero" aria-labelledby="home-title">
                            <div class="hero-kicker">
                                <span>PERSONAL ENGINEERING ARCHIVE</span>
                                <span>00 / HOME</span>
                            </div>

                            <h1 id="home-title">
                                在代码与想法之间，
                                <span>保持可验证的好奇。</span>
                            </h1>

                            <p class="hero-intro">
                                我是罗文聪。这里记录我在数据结构、Linux、AI
                                编程和个人项目中的思考。保持问题意识，记录实现过程，也保留那些尚未完成的探索。
                            </p>

                            <div class="hero-foot">
                                <a class="primary-action" href="/blog">
                                    <span>阅读技术笔记</span>
                                    <svg viewBox="0 0 20 20" aria-hidden="true">
                                        <path d="M4 10h11M11 6l4 4-4 4" />
                                    </svg>
                                </a>
                                <dl class="hero-facts">
                                    <div>
                                        <dt>FOCUS</dt>
                                        <dd>Code / Systems / AI</dd>
                                    </div>
                                    <div>
                                        <dt>MODE</dt>
                                        <dd>Learning in public</dd>
                                    </div>
                                </dl>
                            </div>
                        </section>

                        <section class="latest-posts" aria-labelledby="latest-title">
                            <div class="section-heading">
                                <div class="section-title">
                                    <span>02</span>
                                    <h2 id="latest-title">最新文章</h2>
                                </div>
                                <a class="archive-link" href="/blog">
                                    全部博客
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </div>

                            <div class="post-grid">
                                {
                                    latestCards.map((card) =>
                                        card.kind === "post" ? (
                                            <a class="post-card" href={card.href}>
                                                <div class="card-topline">
                                                    <span class="card-number">{card.number}</span>
                                                    <span class="card-category">
                                                        {card.category}
                                                    </span>
                                                </div>
                                                <div class="card-copy">
                                                    <span class="card-kicker">BLOG ENTRY</span>
                                                    <h3>{card.title}</h3>
                                                    <p>{card.description}</p>
                                                </div>
                                                <div class="card-meta">
                                                    <time datetime={card.dateTime}>
                                                        {card.dateLabel}
                                                    </time>
                                                    <span class="card-arrow" aria-hidden="true">
                                                        ↗
                                                    </span>
                                                </div>
                                            </a>
                                        ) : (
                                            <div class="post-card post-card--empty">
                                                <div class="card-topline">
                                                    <span class="card-number">{card.number}</span>
                                                    <span class="card-category">RESERVED</span>
                                                </div>
                                                <div class="card-copy">
                                                    <span class="card-kicker">NEXT NOTE</span>
                                                    <h3>等待下一篇笔记</h3>
                                                    <p>新的技术记录正在整理中。</p>
                                                </div>
                                                <div class="card-meta">
                                                    <span>NOT PUBLISHED</span>
                                                    <span class="slot-mark" aria-hidden="true">
                                                        +
                                                    </span>
                                                </div>
                                            </div>
                                        ),
                                    )
                                }
                            </div>
                        </section>

                        <footer class="site-footer">
                            <p>© 2026 Luo Wencong</p>
                            <div>
                                <a href="mailto:luowencong12@gmail.com">Email</a>
                                <a
                                    href="https://github.com/luowencong1727"
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    GitHub ↗
                                </a>
                            </div>
                        </footer>
                    </div>
                </main>
            </div>
        </div>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #f3f1ea;
        scroll-behavior: smooth;
    }

    :global(body) {
        margin: 0;
        background: #f3f1ea;
    }

    .home-shell {
        --paper: #f3f1ea;
        --paper-deep: #e9e6dd;
        --surface: #fbfaf6;
        --ink: #121a17;
        --muted: #68716c;
        --line: rgba(18, 26, 23, 0.14);
        --line-strong: rgba(18, 26, 23, 0.27);
        --accent: #155e4b;
        --accent-soft: #dce9e3;
        --sans:
            "Segoe UI Variable Text", "Aptos", "PingFang SC", "Microsoft YaHei",
            sans-serif;
        --mono:
            "Cascadia Code", "SFMono-Regular", Consolas, "Liberation Mono",
            monospace;

        position: relative;
        isolation: isolate;
        min-height: 100vh;
        overflow: clip;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
    }

    .home-shell::before {
        position: fixed;
        z-index: -1;
        inset: 0;
        background-image:
            linear-gradient(rgba(18, 26, 23, 0.046) 1px, transparent 1px),
            linear-gradient(90deg, rgba(18, 26, 23, 0.046) 1px, transparent 1px);
        background-size: 32px 32px;
        content: "";
        mask-image: linear-gradient(to bottom, black, transparent 82%);
        pointer-events: none;
    }

    .home-shell a {
        color: inherit;
        text-decoration: none;
    }

    .home-shell a:focus-visible,
    .home-shell summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    .site-header {
        position: sticky;
        z-index: 50;
        top: 0;
        display: grid;
        grid-template-columns: minmax(246px, 300px) minmax(0, 1fr);
        height: 76px;
        border-bottom: 1px solid var(--line-strong);
        background: rgba(243, 241, 234, 0.94);
        backdrop-filter: blur(16px);
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        padding: 0 24px;
        border-right: 1px solid var(--line);
    }

    .brand-monogram {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid var(--ink);
        border-radius: 50%;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .brand-monogram span {
        color: var(--accent);
    }

    .brand-text {
        display: grid;
        min-width: 0;
        gap: 2px;
    }

    .brand-text strong {
        overflow: hidden;
        font-size: 13px;
        font-weight: 650;
        letter-spacing: -0.01em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .brand-text span {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-width: 0;
        padding: 0 clamp(24px, 4vw, 64px);
    }

    .top-nav {
        display: flex;
        align-items: center;
        gap: clamp(20px, 3vw, 42px);
    }

    .top-nav a {
        position: relative;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: color 160ms ease;
    }

    .top-nav a span {
        margin-right: 7px;
        color: #929a95;
        font-size: 8px;
        font-weight: 500;
    }

    .top-nav a:hover,
    .top-nav a.is-active {
        color: var(--accent);
    }

    .top-nav a.is-active::after {
        position: absolute;
        right: 0;
        bottom: -27px;
        left: 0;
        height: 2px;
        background: var(--accent);
        content: "";
    }

    .build-state {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
        white-space: nowrap;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-soft);
    }

    .page-frame {
        display: grid;
        grid-template-columns: minmax(246px, 300px) minmax(0, 1fr);
        min-width: 0;
        min-height: calc(100vh - 76px);
    }

    .content-directory {
        position: sticky;
        top: 76px;
        display: flex;
        align-self: start;
        flex-direction: column;
        min-width: 0;
        height: calc(100vh - 76px);
        overflow-y: auto;
        padding: 30px 20px 20px;
        border-right: 1px solid var(--line-strong);
        background: rgba(235, 232, 223, 0.86);
        scrollbar-color: var(--line-strong) transparent;
        scrollbar-width: thin;
    }

    .directory-heading {
        display: flex;
        justify-content: space-between;
        padding: 0 6px 21px;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.13em;
    }

    .directory-tree {
        border-top: 1px solid var(--line-strong);
    }

    .directory-group {
        border-bottom: 1px solid var(--line-strong);
    }

    .directory-group summary {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr) auto 14px;
        align-items: center;
        gap: 9px;
        padding: 19px 6px;
        cursor: pointer;
        list-style: none;
        user-select: none;
    }

    .directory-group summary::-webkit-details-marker {
        display: none;
    }

    .directory-number,
    .directory-count {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.06em;
    }

    .directory-label {
        font-size: 13px;
        font-weight: 650;
        letter-spacing: -0.01em;
    }

    .directory-chevron {
        width: 14px;
        height: 14px;
        fill: none;
        stroke: var(--muted);
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.4;
        transition: transform 180ms ease;
    }

    .directory-group[open] .directory-chevron {
        transform: rotate(180deg);
    }

    .directory-group[open] summary {
        color: var(--accent);
    }

    .directory-panel {
        display: grid;
        gap: 3px;
        padding: 0 6px 15px 43px;
    }

    .directory-overview,
    .directory-entry {
        display: grid;
        grid-template-columns: 24px minmax(0, 1fr) auto;
        gap: 4px;
        align-items: center;
        min-height: 34px;
        padding: 6px 8px;
        border-radius: 5px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.45;
        transition:
            background 150ms ease,
            color 150ms ease;
    }

    .directory-entry {
        grid-template-columns: 24px minmax(0, 1fr);
    }

    .directory-overview span:first-child,
    .directory-entry span:first-child {
        font-family: var(--mono);
        font-size: 8px;
    }

    .directory-overview:hover,
    .directory-entry:hover {
        background: rgba(255, 255, 255, 0.52);
        color: var(--ink);
    }

    .directory-empty {
        margin: 4px 8px 0;
        padding: 12px 0 5px 12px;
        border-left: 1px solid var(--line-strong);
        color: var(--muted);
        font-size: 10px;
        line-height: 1.7;
    }

    .directory-empty span {
        display: block;
        color: #929a95;
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.07em;
    }

    .directory-note {
        margin-top: auto;
        padding: 24px 6px 4px;
        border-top: 1px solid var(--line);
    }

    .directory-note span {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 0.12em;
    }

    .directory-note p {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 10px;
    }

    .home-main {
        min-width: 0;
        padding: clamp(32px, 4vw, 58px) clamp(24px, 5vw, 76px) 20px;
    }

    .content-column {
        width: 100%;
        max-width: 1180px;
        min-width: 0;
        margin-left: auto;
    }

    .hero {
        max-width: 780px;
        min-width: 0;
        margin-right: clamp(0px, 4vw, 64px);
        margin-left: auto;
        padding: clamp(52px, 8vw, 118px) 0 clamp(76px, 9vw, 126px);
    }

    .hero-kicker {
        display: flex;
        align-items: center;
        gap: 16px;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 8px;
        letter-spacing: 0.12em;
    }

    .hero-kicker::before {
        width: 42px;
        height: 1px;
        background: var(--accent);
        content: "";
    }

    .hero-kicker span:last-child {
        color: var(--accent);
    }

    .hero h1 {
        max-width: 760px;
        margin: 27px 0 30px;
        font-size: clamp(2.65rem, 6vw, 5.4rem);
        font-weight: 650;
        letter-spacing: -0.065em;
        line-height: 1.07;
        text-wrap: balance;
    }

    .hero h1 span {
        display: block;
        color: var(--accent);
    }

    .hero-intro {
        width: 100%;
        max-width: 610px;
        margin: 0;
        color: #4e5a54;
        font-size: clamp(14px, 1.25vw, 17px);
        letter-spacing: 0.01em;
        line-height: 1.95;
        overflow-wrap: anywhere;
    }

    .hero-foot {
        display: flex;
        align-items: flex-end;
        gap: clamp(28px, 5vw, 68px);
        margin-top: 42px;
    }

    .primary-action {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        min-width: 198px;
        padding: 13px 15px 13px 18px;
        border: 1px solid var(--ink);
        border-radius: 3px;
        background: var(--ink);
        color: var(--surface) !important;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        transition:
            background 180ms ease,
            color 180ms ease,
            transform 180ms ease;
    }

    .primary-action svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.4;
    }

    .primary-action:hover {
        transform: translateY(-2px);
        background: var(--accent);
        color: white !important;
    }

    .hero-facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
        margin: 0;
    }

    .hero-facts div {
        display: grid;
        min-width: 0;
        gap: 5px;
    }

    .hero-facts dt {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: 0.13em;
    }

    .hero-facts dd {
        margin: 0;
        font-family: var(--mono);
        font-size: 9px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .latest-posts {
        max-width: 1000px;
        margin-left: auto;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
        padding-bottom: 17px;
        border-bottom: 1px solid var(--line-strong);
    }

    .section-title {
        display: flex;
        align-items: baseline;
        gap: 13px;
    }

    .section-title > span {
        color: var(--accent);
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.05em;
    }

    .section-title h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 650;
        letter-spacing: -0.025em;
    }

    .archive-link {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--muted) !important;
        font-family: var(--mono);
        font-size: 9px;
        letter-spacing: 0.04em;
        transition: color 160ms ease;
    }

    .archive-link:hover {
        color: var(--accent) !important;
    }

    .archive-link span {
        font-size: 13px;
    }

    .post-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .post-card {
        position: relative;
        display: flex;
        min-height: 276px;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        padding: 21px;
        border: 1px solid var(--line-strong);
        border-radius: 18px;
        background: rgba(251, 250, 246, 0.9);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.75) inset;
        transition:
            transform 200ms ease,
            border-color 200ms ease,
            box-shadow 200ms ease;
    }

    .post-card::before {
        position: absolute;
        top: 0;
        right: 22px;
        left: 22px;
        height: 2px;
        background: var(--accent);
        content: "";
        opacity: 0;
        transform: scaleX(0.45);
        transform-origin: left;
        transition:
            opacity 200ms ease,
            transform 200ms ease;
    }

    a.post-card:hover {
        z-index: 1;
        border-color: var(--accent);
        box-shadow: 0 18px 40px rgba(31, 45, 39, 0.09);
        transform: translateY(-5px);
    }

    a.post-card:hover::before {
        opacity: 1;
        transform: scaleX(1);
    }

