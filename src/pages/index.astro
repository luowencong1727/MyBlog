---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latestPosts = allPosts.slice(0, 3);
const emptySlots = Math.max(0, 3 - latestPosts.length);

const latestCards = [
    ...latestPosts.map((post, index) => ({
        kind: "post" as const,
        number: String(index + 1).padStart(2, "0"),
        title: post.data.title,
        description: post.data.description,
        category: post.data.category,
        href: `/blog/${post.id}`,
        dateLabel: post.data.date.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            timeZone: "Asia/Shanghai",
        }),
        dateTime: post.data.date.toISOString().slice(0, 10),
    })),
    ...Array.from({ length: emptySlots }, (_, index) => ({
        kind: "empty" as const,
        number: String(latestPosts.length + index + 1).padStart(2, "0"),
    })),
];
---

<Layout active="home">
    <div class="home-page">
        <section class="home-hero" aria-labelledby="home-title">
            <div class="home-kicker">
                <span>PERSONAL ENGINEERING ARCHIVE</span>
                <span>00 / HOME</span>
            </div>

            <h1 id="home-title">
                在代码与想法之间，
                <span>保持可验证的好奇。</span>
            </h1>

            <p class="home-intro">
                我是罗文聪。这里记录我在数据结构、Linux、AI
                编程和个人项目中的思考。保持问题意识，记录实现过程，也保留那些尚未完成的探索。
            </p>

            <div class="home-actions">
                <a class="primary-action" href="/blog">
                    <span>阅读技术笔记</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h11M11 6l4 4-4 4" />
                    </svg>
                </a>

                <dl class="home-facts">
                    <div>
                        <dt>FOCUS</dt>
                        <dd>Code / Systems / AI</dd>
                    </div>
                    <div>
                        <dt>MODE</dt>
                        <dd>Learning in public</dd>
                    </div>
                </dl>
            </div>
        </section>

        <section class="latest-posts" aria-labelledby="latest-title">
            <div class="section-heading">
                <div class="section-title">
                    <span>02</span>
                    <h2 id="latest-title">最新文章</h2>
                </div>
                <a class="archive-link" href="/blog">
                    全部博客
                    <span aria-hidden="true">↗</span>
                </a>
            </div>

            <div class="post-grid">
                {
                    latestCards.map((card) =>
                        card.kind === "post" ? (
                            <a class="post-card" href={card.href}>
                                <div class="card-topline">
                                    <span class="card-number">{card.number}</span>
                                    <span class="card-category">{card.category}</span>
                                </div>
                                <div class="card-copy">
                                    <span class="card-kicker">BLOG ENTRY</span>
                                    <h3>{card.title}</h3>
                                    <p>{card.description}</p>
                                </div>
                                <div class="card-meta">
                                    <time datetime={card.dateTime}>
                                        {card.dateLabel}
                                    </time>
                                    <span class="card-arrow" aria-hidden="true">
                                        ↗
                                    </span>
                                </div>
                            </a>
                        ) : (
                            <div class="post-card post-card--empty">
                                <div class="card-topline">
                                    <span class="card-number">{card.number}</span>
                                    <span class="card-category">RESERVED</span>
                                </div>
                                <div class="card-copy">
                                    <span class="card-kicker">NEXT NOTE</span>
                                    <h3>等待下一篇笔记</h3>
                                    <p>新的技术记录正在整理中。</p>
                                </div>
                                <div class="card-meta">
                                    <span>NOT PUBLISHED</span>
                                    <span class="slot-mark" aria-hidden="true">
                                        +
                                    </span>
                                </div>
                            </div>
                        ),
                    )
                }
            </div>
        </section>
    </div>
</Layout>
